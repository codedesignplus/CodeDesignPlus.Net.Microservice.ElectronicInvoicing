{
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://*:5000",
        "Protocols": "Http1"
      },
      "Http2": {
        "Url": "http://*:5001",
        "Protocols": "Http2"
      }
    }
  },
  "Core": {
    "AppName": "ms-electronicinvoicing",
    "TypeEntryPoint": "grpc",
    "Version": "v1",
    "Description": "This microservice issues electronic documents (invoices, credit notes and debit notes) through technology providers.",
    "Business": "CodeDesignPlus",
    "Contact": {
      "Name": "CodeDesignPlus",
      "Email": "support@codedesignplus.com"
    }
  },
  "Security": {
    "ClientId": "",
    "IncludeErrorDetails": true,
    "ValidateAudience": false,
    "ValidateIssuer": true,
    "ValidateLifetime": true,
    "RequireHttpsMetadata": true,
    "ValidIssuer": "",
    "ValidAudiences": [],
    "Applications": []
  },
  "Redis": {
    "Instances": {
      "Core": {
        "ConnectionString": "localhost:6379"
      }
    }
  },
  "RedisCache": {
    "Enable": true,
    "Expiration": "00:05:00"
  },
  "RabbitMQ": {
    "Enable": false,
    "UseQueue": false,
    "Host": "localhost",
    "Port": 5672,
    "UserName": "user",
    "Password": "pass",
    "EnableDiagnostic": true
  },
  "ServiceBus": {
    "Enable": true,
    "UseQueue": false,
    "EnableDiagnostic": true
  },
  "Mongo": {
    "Enable": true,
    "ConnectionString": "mongodb://localhost:27017",
    "Database": "db-ms-electronicinvoicing",
    "Diagnostic": {
      "Enable": false,
      "EnableCommandText": false
    }
  },
  "Logger": {
    "Enable": true,
    "OTelEndpoint": "http://127.0.0.1:4317",
    "Level": "Warning"
  },
  "Observability": {
    "Enable": true,
    "ServerOtel": "http://localhost:4317",
    "Trace": {
      "Enable": true,
      "AspNetCore": true,
      "GrpcClient": true,
      "SqlClient": false,
      "CodeDesignPlusSdk": true,
      "Redis": true,
      "Kafka": false,
      "RabbitMQ": true
    },
    "Metrics": {
      "Enable": true,
      "AspNetCore": true
    }
  },
  "Vault": {
    "Enable": true,
    "Address": "http://127.0.0.1:8200",
    "AppName": "ms-electronicinvoicing",
    "Solution": "security-codedesignplus",
    "Token": "root",
    "Mongo": {
      "Enable": true,
      "TemplateConnectionString": "mongodb://{0}:{1}@localhost:27017"
    },
    "RabbitMQ": {
      "Enable": true
    }
  },
  "GrpcClients": {
    "Notification": "http://ms-notification-grpc.codedesignplus.svc.cluster.local:5001",
    "Location": "http://ms-locations-grpc.kappali.svc.cluster.local:5001",
    "FileStorage": "http://ms-filestorage-grpc.kappali.svc.cluster.local:5001"
  },
  "ElectronicInvoicing": {
    "Routing": {
      "CO": [
        "Aliaddo",
        "Alanube"
      ]
    },
    "PlatformTenant": "e1ec7201-0000-4000-8000-000000000001",
    "SystemUser": "10000000-0000-0000-0000-000000000001",
    "PlatformIssuer": {
      "ReservedDocuments": 500
    },
    "ProviderPlan": {
      "Provider": "Aliaddo",
      "Documents": 40000,
      "ValidFrom": "2026-11-04T05:00:00Z",
      "ValidUntil": "2027-11-04T05:00:00Z",
      "AlertPercentages": [
        70,
        90
      ],
      "ExpiryNotice": "30.00:00:00"
    },
    "Quota": {
      "AttributeKeys": [
        "einvoicing_documents"
      ],
      "AlertPercentages": [
        80,
        100
      ]
    },
    "StatusCheck": {
      "InitialDelay": "00:01:00",
      "BackoffFactor": 2,
      "MaxDelay": "00:30:00",
      "MaxAttempts": 12,
      "SentTimeout": "06:00:00",
      "BatchSize": 100,
      "Lease": "00:03:00"
    },
    "NumberingAlerts": {
      "RemainingPercentage": 10,
      "DaysBeforeExpiry": 30
    },
    "SecretsKeyName": "electronic-issuers",
    "SecretsCacheLifetime": "00:10:00",
    "SuspendAfterCredentialRejections": 3,
    "FilesTarget": "electronic-documents"
  },
  "Aliaddo": {
    "BaseUrl": "https://nitro.aliaddo.net",
    "Master": {
      "Token": ""
    },
    "LineDiscountName": "Descuento",
    "SendTimeout": "00:01:00",
    "Documents": {
      "Invoice": {
        "Code": "01",
        "OperationType": "10",
        "Format": "Standard"
      },
      "CreditNote": {
        "Code": "91",
        "OperationType": "20",
        "Format": "Standard"
      },
      "DebitNote": {
        "Code": "92",
        "OperationType": "30",
        "Format": "Standard"
      },
      "PosTicket": {
        "Code": "20",
        "OperationType": "10",
        "Format": "PosX80mm"
      }
    },
    "Webhooks": {
      "Enabled": false,
      "Algorithm": "HMACSHA256",
      "Encoding": "hex"
    },
    "Resilience": {
      "Enable": true,
      "MaxRetryAttempts": 3,
      "RetryBaseDelaySeconds": 2.0,
      "RetryMaxDelaySeconds": 10.0,
      "CircuitBreakerFailureRatio": 0.5,
      "CircuitBreakerMinimumThroughput": 10,
      "CircuitBreakerBreakDurationSeconds": 30.0,
      "CircuitBreakerSamplingDurationSeconds": 60.0,
      "TimeoutSeconds": 30.0
    }
  },
  "Alanube": {
    "BaseUrl": "https://api.alegra.com/e-provider/col/v1",
    "Master": {
      "Token": "",
      "TokenKey": ""
    },
    "SendTimeout": "00:01:30",
    "CreditPaymentForm": "2",
    "TaxSchemeByRegime": {
      "48": "01",
      "49": "ZZ"
    },
    "UseProviderCertificate": true,
    "NotifyBuyerByEmail": true,
    "Documents": {
      "Invoice": {
        "DocumentType": "01"
      },
      "CreditNote": {
        "DocumentType": "91",
        "CorrectedDocumentType": "01"
      },
      "DebitNote": {
        "CorrectedDocumentType": "01"
      },
      "PosTicket": {
        "DocumentType": "20"
      }
    },
    "ErrorCodes": {
      "IssuerNotReady": [
        "AEP1002",
        "AEP1005",
        "AEP1006",
        "AEP1007",
        "AEP6008",
        "AEP6012",
        "AEP6013",
        "AEP6014",
        "AEP6015",
        "AEP6016",
        "AEP6017",
        "AEP13008",
        "AEP15008",
        "AEP17001",
        "AEP18013"
      ],
      "AlreadyReceived": [
        "AEP6009",
        "AEP6010",
        "AEP7009",
        "AEP7010",
        "AEP8009",
        "AEP8010"
      ]
    },
    "Webhooks": {
      "Enabled": false,
      "Header": "x-webhook-secret"
    },
    "Resilience": {
      "Enable": true,
      "MaxRetryAttempts": 3,
      "RetryBaseDelaySeconds": 2.0,
      "RetryMaxDelaySeconds": 10.0,
      "CircuitBreakerFailureRatio": 0.5,
      "CircuitBreakerMinimumThroughput": 10,
      "CircuitBreakerBreakDurationSeconds": 30.0,
      "CircuitBreakerSamplingDurationSeconds": 60.0,
      "TimeoutSeconds": 30.0
    }
  },
  "Simulated": {
    "DefaultOutcome": "Accepted",
    "Rules": [
      {
        "BuyerIdentification": "222222222",
        "Outcome": "Rejected",
        "Reason": "Rechazo simulado: el adquiriente no existe."
      },
      {
        "BuyerIdentification": "333333333",
        "Outcome": "DianUnavailable",
        "ChecksUntilResolved": 2
      },
      {
        "BuyerIdentification": "444444444",
        "Outcome": "ProviderUnavailable"
      },
      {
        "BuyerIdentification": "555555555",
        "Outcome": "Processing",
        "ChecksUntilResolved": 3
      }
    ],
    "Resolutions": []
  }
}
